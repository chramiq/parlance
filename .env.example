# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AI...
GEMINI_MODEL=gemini-3.8-flash
# Voice practice sessions (Gemini Live); differs from GEMINI_MODEL on purpose
GEMINI_LIVE_MODEL=gemini-3.8-live

# Language pair (ISO 639-1): you know / you want to speak
KNOWN_LANG=cs
TARGET_LANG=pl

# TTS voice for the target language
TTS_VOICE=pl-PL-ZofiaNeural

# When on, the agent may skip words whose similar-known twin means the SAME
# (system~systém), judged by the model word by word
SKIP_FREE_COGNATES=false
