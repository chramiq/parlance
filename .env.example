# LiteLLM gateway (OpenAI-compatible)
LITELLM_BASE_URL=https://litellm-gateway.example/v1
LITELLM_API_KEY=sk-...
# probed default 2026-09: glm-5.3 (all output modes pass via the metadata
# hook; see docs/0004). Any chat model on the gateway works.
LITELLM_MODEL=glm-5.3

# Language pair (ISO 639-1): you know / you want to speak
KNOWN_LANG=cs
TARGET_LANG=pl

# TTS voice for the target language (edge-tts voice id; only
# pl-PL-MarekNeural / pl-PL-ZofiaNeural exist — verified 2026-09)
TTS_VOICE=pl-PL-ZofiaNeural

# Your display name in chat exports, used to split "my messages" from "theirs"
CHAT_SELF_NAME=
